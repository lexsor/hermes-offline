diff --git a/apps/desktop/electron/offline-profile.ts b/apps/desktop/electron/offline-profile.ts
new file mode 100644
index 0000000..6d15f94
--- /dev/null
+++ b/apps/desktop/electron/offline-profile.ts
@@ -0,0 +1,58 @@
+// Offline Hermes (patch 0002): make a direct launch of Hermes.exe behave like
+// launch-hermes.cmd. When this app sits inside an Offline Hermes install
+// (<root>\app\Hermes.exe beside <root>\install-state.json), apply the
+// launcher's environment before anything reads it, and mark the process as
+// offline so main.ts refuses the networked first-run/repair installer.
+import fs from 'node:fs'
+import path from 'node:path'
+
+interface OfflineInstallState {
+  profile?: string
+  hermes_home?: string
+}
+
+export function applyOfflineProfile(execPath: string = process.execPath, env: NodeJS.ProcessEnv = process.env): string | null {
+  const installRoot = path.dirname(path.dirname(execPath))
+  let state: OfflineInstallState | null = null
+
+  try {
+    let raw = fs.readFileSync(path.join(installRoot, 'install-state.json'), 'utf8')
+    // Windows PowerShell 5.1 writes install-state.json with a UTF-8 BOM.
+    if (raw.charCodeAt(0) === 0xfeff) raw = raw.slice(1)
+    state = JSON.parse(raw) as OfflineInstallState
+  } catch {
+    return null
+  }
+
+  if (!state || state.profile !== 'windows-x64-desktop' || !state.hermes_home) {
+    return null
+  }
+
+  env.OFFLINE_HERMES_INSTALL_ROOT = installRoot
+  // Same precedence as launch-hermes.cmd: OFFLINE_HERMES_HOME, else the home
+  // recorded at install time. Never a host-wide HERMES_HOME of an online install.
+  env.HERMES_HOME = env.OFFLINE_HERMES_HOME || state.hermes_home
+  // Electron's own user data (local storage, caches, desktop settings, and the
+  // single-instance lock) lives beside the offline home instead of the
+  // %APPDATA%\Hermes shared with any online Hermes Desktop build. main.ts
+  // applies HERMES_DESKTOP_USER_DATA_DIR before taking the instance lock.
+  env.HERMES_DESKTOP_USER_DATA_DIR = env.HERMES_DESKTOP_USER_DATA_DIR || path.join(env.HERMES_HOME, 'desktop-user-data')
+  env.HERMES_DESKTOP_HERMES = path.join(installRoot, 'venv', 'Scripts', 'hermes.exe')
+  env.HERMES_DISABLE_LAZY_INSTALLS = '1'
+  env.UV_OFFLINE = '1'
+  env.PIP_NO_INDEX = '1'
+
+  const runtimeDirs = [
+    path.join(installRoot, 'runtime', 'node'),
+    path.join(installRoot, 'runtime', 'git', 'cmd'),
+    path.join(installRoot, 'runtime', 'ripgrep'),
+    path.join(installRoot, 'venv', 'Scripts')
+  ]
+  const currentPath = env.PATH ?? ''
+
+  if (!currentPath.toLowerCase().includes(runtimeDirs[0].toLowerCase())) {
+    env.PATH = [...runtimeDirs, currentPath].filter(Boolean).join(path.delimiter)
+  }
+
+  return installRoot
+}
