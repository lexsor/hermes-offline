# Phase 3 generated output; immutable inputs remain under vendor/.
/dist/
*.staging-*
*.previous-*

# Upstream clone used by the Phase 6 maintenance scripts.
/.maintenance/

# Secrets and user-owned configuration.
.env
config/*.local.*
config/secrets.*

# Phase 4 raw run evidence (firewall/DNS logs, process listings, transcripts).
# Review it, then summarize into reports/; do not commit it wholesale.
/phase4-evidence/
/reports/evidence/

# Python bytecode from the maintenance tool.
__pycache__/
