# Offline-safe defaults. Copy values into your local environment; do not commit secrets.
HERMES_DISABLE_LAZY_INSTALLS=1
UV_OFFLINE=1
PIP_NO_INDEX=1

# Optional local/LAN model provider. Replace with your own endpoint.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=replace-with-local-placeholder-if-your-server-requires-one
